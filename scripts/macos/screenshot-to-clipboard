#!/bin/zsh
# Copy the newest screenshot in a folder to the clipboard, once.
#
# Run by the dev.aval.screenshot-clipboard LaunchAgent whenever the folder
# changes. The file stays on disk; the image is also ready to paste (Cmd+V,
# or Ctrl+V in Claude Code).
#   screenshot-to-clipboard [folder]      default ~/Pictures/Screenshots
# CLIP_CMD replaces the clipboard writer (tests); SETTLE is the wait in
# seconds for macOS to finish writing the file.
emulate -L zsh
setopt null_glob extended_glob

dir=${1:-$HOME/Pictures/Screenshots}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
state=$state_dir/screenshot-clipboard.last

sleep ${SETTLE:-0.4}

# Newest image by modification time. Hidden files are skipped: macOS writes
# ".Captura…" first and renames it when the capture is complete.
files=($dir/*.(#i)(png|jpg|jpeg|heic|tiff)(.om))
(( $#files )) || exit 0
newest=$files[1]

[[ -f $state && "$(<$state)" == "$newest" ]] && exit 0

if [[ -n ${CLIP_CMD:-} ]]; then
  $CLIP_CMD "$newest" || exit 1
else
  case ${newest:e:l} in
    png) class='«class PNGf»' ;;
    jpg|jpeg) class='JPEG picture' ;;
    *) class='TIFF picture' ;;
  esac
  osascript -e "set the clipboard to (read (POSIX file \"$newest\") as $class)" >/dev/null || exit 1
fi

mkdir -p $state_dir
print -r -- $newest >| $state
