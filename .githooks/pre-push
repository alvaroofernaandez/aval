#!/usr/bin/env bash
# Refuse to push commits that carry employer material or secrets.
#
# Scans only what is being pushed (the commits between the remote's tip and the
# local one), so uncommitted local work never blocks a push and an old commit
# is not re-judged on every push. Enabled per clone with:
#   git config core.hooksPath .githooks        (install.sh does this)
# Bypass deliberately with `git push --no-verify`.
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
# shellcheck source=../tests/lib/proprietary-patterns.sh
source "$REPO/tests/lib/proprietary-patterns.sh"

zero=0000000000000000000000000000000000000000
status=0

while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                       # branch deletion
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi

  # shellcheck disable=SC2086
  added="$(git log -p --no-color $range 2>/dev/null | rg '^\+' || true)"
  for p in "${patterns[@]}"; do
    hits="$(printf '%s\n' "$added" | rg -i -n -- "$p" | head -3)"
    if [ -n "$hits" ]; then
      printf 'pre-push: employer material matching /%s/ in outgoing commits:\n%s\n' "$p" "$hits" >&2
      status=1
    fi
  done

  if command -v gitleaks >/dev/null 2>&1; then
    log_opts="${range}"
    if ! gitleaks detect --no-banner --redact --log-opts="$log_opts" >/dev/null 2>&1; then
      echo "pre-push: gitleaks found a secret in outgoing commits (run gitleaks detect for details)" >&2
      status=1
    fi
  fi
done

# Drift between the repo and the live agent config. A WARNING by default: a dev
# pushing from another machine has a different ~/.claude and must not be
# blocked by it. AVAL_PREPUSH_STRICT=1 makes it blocking. Skipped silently when
# the aval binary is not available. AVAL_BIN overrides the binary (tests).
aval_bin="${AVAL_BIN:-aval}"
if command -v "$aval_bin" >/dev/null 2>&1; then
  if ! drift="$("$aval_bin" --repo "$REPO" sync --check 2>&1)"; then
    printf 'pre-push: warning: aval sync --check found drift between the repo and your live config:\n%s\n' "$drift" >&2
    if [ "${AVAL_PREPUSH_STRICT:-0}" = "1" ]; then
      echo "pre-push: AVAL_PREPUSH_STRICT=1, so this blocks the push (run aval sync)." >&2
      status=1
    fi
  fi
fi

[ "$status" -eq 0 ] || echo "pre-push: push refused. Fix the commits, or bypass deliberately with --no-verify." >&2
exit "$status"
