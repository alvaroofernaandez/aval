# Single source of truth for what gets installed and where.
#
# The Go installer under cmd/aval (TUI and `--yes`) reads this file. Keeping the
# list in one place is the whole point — a second copy diverges the first time
# an entry is added to one and not the other, and the failure is silent: the
# config just never gets linked. tests/manifest_test.go fails the build if the
# installer and this file ever disagree.
#
# Format
# ------
# Section header      [<id>]
#   label     = human-readable name, shown by the TUI
#   detail    = one line describing what the group is
#   platforms = unix  -> macOS and Linux only (and Windows via WSL)
#               all   -> also Windows natively
#
# Entries             <source relative to repo>   <destination relative to $HOME>
#
# Agent config directories are listed PER PATH, never wholesale: ~/.claude also
# holds .credentials.json and gigabytes of session history, and
# ~/.config/opencode holds node_modules. Linking either one entirely would
# displace all of it.

[terminal]
label = Terminal environment
detail = tmux, yazi, Ghostty, zsh and Powerlevel10k
platforms = unix

config/yazi                        .config/yazi
config/yazi-sidebar                .config/yazi-sidebar
config/ghostty                     .config/ghostty
config/herdr-core/templates        .config/herdr-core/templates
config/herdr-app/keys.json         .config/herdr-app/keys.json
config/herdr-app/mods/diff-review  .config/herdr-app/mods/diff-review
home/tmux.conf                     .tmux.conf
home/zshrc                         .zshrc
home/zprofile                      .zprofile
home/p10k.zsh                      .p10k.zsh

# bat, zoxide, fzf and eza have no config files of their own: their setup lives
# in .zshrc above.
config/atuin/config.toml           .config/atuin/config.toml

[git]
label = Git and GitHub CLI
detail = Global gitconfig, ignore rules and gh settings
platforms = all

home/gitconfig                     .gitconfig
config/gh/config.yml               .config/gh/config.yml
config/git/ignore                  .config/git/ignore

[claude]
label = Claude Code
detail = Instructions, agents, commands, hooks and themes
platforms = all

config/claude/CLAUDE.md            .claude/CLAUDE.md
config/claude/RTK.md               .claude/RTK.md
config/claude/MCP-PER-PROJECT.md   .claude/MCP-PER-PROJECT.md
# Claude settings are not linked: `aval sync` owns the live file (seeded
# by the installers) so personal keys and the private overlay stay out of git.
config/claude/agents               .claude/agents
config/claude/commands             .claude/commands
config/claude/lessons              .claude/lessons
config/claude/themes               .claude/themes
# The relay mod, loaded only when `aval relay enable` adds it to the plugin
# dirs in the live settings (odd/tasks/relay.md, T10).
config/claude/plugins/aval-relay   .claude/aval-relay

[opencode]
label = OpenCode
detail = Config, agents, commands, plugins and profiles
platforms = all

config/opencode/opencode.json      .config/opencode/opencode.json
config/opencode/AGENTS.md          .config/opencode/AGENTS.md
config/opencode/package.json       .config/opencode/package.json
config/opencode/agents             .config/opencode/agents
config/opencode/commands           .config/opencode/commands
config/opencode/plugin             .config/opencode/plugin
config/opencode/profiles           .config/opencode/profiles

[skills]
label = Agent skills
detail = Shared skills, linked into every agent's skills directory
platforms = all

# Skills are tool-agnostic, so each one goes into every agent's skills
# directory — but ONE BY ONE, never by linking the directory itself. Those
# directories also hold marketplace skills this repo does not version, and
# replacing a directory with a link would take all of them out of service.
#
# Commands and agents are deliberately not shared this way: OpenCode's carry
# their own frontmatter (agent:, subtask:) and tool-specific paths, so each
# tool keeps its own copy above.
fanout-source = skills
fanout-dests = .claude/skills .config/opencode/skills .opencode/skills
