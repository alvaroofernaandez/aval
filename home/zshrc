# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Startup budget: tests/shell-startup.test.sh keeps `zsh -i -c exit` under 80 ms.
# Rules that keep it there: no framework (oh-my-zsh cost ~27 ms for one plugin),
# no tool init script generated by a subprocess on every start (cached below), no subprocess for
# facts zsh already knows ($OSTYPE instead of uname, ${GOPATH} instead of go env).

# Keep PATH free of duplicates. Every export below prepends to the inherited
# PATH, so nested shells (Ghostty -> tmux -> zsh) would otherwise stack the same
# directories once per level. -U makes zsh drop repeats automatically.
typeset -U path PATH

# Detect Termux
IS_TERMUX=0
if [[ -n "$TERMUX_VERSION" ]] || [[ -d "/data/data/com.termux" ]]; then
    IS_TERMUX=1
fi

# Set PATH based on platform
if [[ $IS_TERMUX -eq 1 ]]; then
    # Termux - use PREFIX for binaries
    export PATH="$PREFIX/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
else
    export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:$PATH"
fi

# Set nvim as default editor for opencode and other tools
export EDITOR="nvim"
export VISUAL="nvim"

export LS_COLORS="di=38;5;67:ow=48;5;60:ex=38;5;132:ln=38;5;144:*.tar=38;5;180:*.zip=38;5;180:*.jpg=38;5;175:*.png=38;5;175:*.mp3=38;5;175:*.wav=38;5;175:*.txt=38;5;223:*.sh=38;5;132"
# GNU ls (Linux) and BSD ls on macOS 13+ both accept --color.
alias ls='ls --color=auto'

# --- cached tool init ----------------------------------------------------------
# `tool init` prints a script that only changes when the tool is upgraded, yet
# evaluating it forks a process on every start (~36 ms for five tools). Cache
# the output and regenerate it only when the binary is newer than the cache.
_zinit_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init"
[[ -d $_zinit_cache ]] || mkdir -p "$_zinit_cache"
_cached_init() {  # _cached_init <name> <command> [args...]
  local name=$1; shift
  local bin=${commands[$1]:-$1}
  [[ -x $bin ]] || return 0
  local file=$_zinit_cache/$name.zsh
  if [[ ! -s $file || $bin -nt $file ]]; then
    "$bin" "${@:2}" >| "$file" 2>/dev/null
  fi
  source "$file"
}

# Homebrew setup (skip on Termux)
if [[ $IS_TERMUX -eq 0 ]]; then
    if [[ $OSTYPE == darwin* ]]; then
        if [[ -x /opt/homebrew/bin/brew ]]; then
            BREW_BIN="/opt/homebrew/bin"   # Apple Silicon
        elif [[ -x /usr/local/bin/brew ]]; then
            BREW_BIN="/usr/local/bin"      # Intel
        fi
    else
        BREW_BIN="/home/linuxbrew/.linuxbrew/bin"
    fi
    [[ -n "$BREW_BIN" ]] && _cached_init brew-shellenv "$BREW_BIN/brew" shellenv
fi

# --- options (replacing oh-my-zsh's lib) ----------------------------------------
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_space hist_verify share_history
setopt auto_cd auto_pushd pushd_ignore_dups pushdminus interactive_comments
bindkey -e
alias -g ...='../..'
alias -g ....='../../..'
alias -- -='cd -'
alias md='mkdir -p'

# Zsh plugins - different paths for Termux vs Homebrew. zsh-autocomplete runs
# compinit itself and asks that nothing else does, so it is loaded first and
# nothing below calls compinit.
if [[ $IS_TERMUX -eq 1 ]]; then
    _zplug="$PREFIX/share"
else
    _zplug="${BREW_BIN:h}/share"
fi
for _p in zsh-autocomplete/zsh-autocomplete.plugin.zsh \
          zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
          zsh-autosuggestions/zsh-autosuggestions.zsh \
          powerlevel10k/powerlevel10k.zsh-theme; do
    [[ -r $_zplug/$_p ]] && source "$_zplug/$_p"
done
unset _p _zplug

export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

# alias
alias fzfbat='fzf --preview="bat --theme=gruvbox-dark --color=always {}"'
alias fzfnvim='nvim $(fzf --preview="bat --theme=gruvbox-dark --color=always {}")'
alias cplan='claude --agent planner --permission-mode default'
alias cimpl='claude --agent implementer --permission-mode default'
alias csmall='claude --agent smallops --permission-mode default'
alias ccr='claude --resume'
alias ll='eza -l --git'
alias la='eza -la --git'
# Helpers from the habits audit, next to this file in the repo (follows the symlink).
source "${${(%):-%x}:A:h}/zsh/helpers.zsh"

export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
_cached_init carapace carapace _carapace zsh
_cached_init fzf fzf --zsh
_cached_init zoxide zoxide init zsh
_cached_init atuin atuin init zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# Optional auto-start tmux (disabled by default).
# Enable only if you want it: export AUTO_TMUX=1
if [[ $- == *i* ]] && [[ -n "$AUTO_TMUX" ]] && (( $+commands[tmux] )); then
  if [[ -z "$TMUX" && -z "$NO_AUTO_TMUX" && -z "$SSH_CONNECTION" && "$TERM" != "dumb" && "$TERM_PROGRAM" != "vscode" && -t 0 && -t 1 ]]; then
    tmux new-session -A -s main || true
  fi
fi

# >>> secrets >>>
# Credentials live outside the versioned dotfiles. Guarded so a missing file
# never breaks the shell on a machine that has not been set up yet.
[ -r "$HOME/.config/zsh/secrets.zsh" ] && source "$HOME/.config/zsh/secrets.zsh"
# <<< secrets <<<

# >>> sidebar follow >>>
# Keeps the yazi sidebar tree on whatever directory this pane is in, so cd and z
# move the tree too. The command exits immediately and silently when there is no
# sidebar, so this costs nothing in the common case and can never break a cd.
autoload -Uz add-zsh-hook
_sidebar_follow_cwd() {
  [[ -n "$TMUX" && -x "$HOME/.local/bin/aval" ]] && "$HOME/.local/bin/aval" tmux sidebar-follow "$PWD"
}
add-zsh-hook chpwd _sidebar_follow_cwd
# <<< sidebar follow <<<

# Go binaries. ${GOPATH} defaults to ~/go; asking `go env` costs a fork per shell.
export PATH="${GOPATH:-$HOME/go}/bin:$PATH"

export PATH="$HOME/.stripe/bin:$PATH"

# Added by Kiri: its docker and kiri commands (kiri setup --uninstall removes this)
case ":$PATH:" in *":$HOME/.kiri/bin:"*) ;; *) export PATH="$PATH:$HOME/.kiri/bin" ;; esac

# Kiri: builds go to an isolated BuildKit builder. Kiri's own `kiri` builder resolves
# docker.io/quay.io through a mirror of the local store, which hands back the arm64
# variant even for --platform linux/amd64 (silent wrong-arch deploy images).
export BUILDX_BUILDER=multiarch

# Drop PATH entries that do not exist on this machine (Termux, Nix, Intel brew…),
# so lookups never stat directories that are not there.
path=(${^path}(N-/))
