[ripgrep]
layer = env
used_by = config CLAUDE.md, config AGENTS.md
if_missing = degrades
native_substitute = none
probe = bin rg

[fd]
layer = env
used_by = config CLAUDE.md, install terminal
if_missing = degrades
native_substitute = none
probe = bin fd

[bat]
layer = env
used_by = config CLAUDE.md, install terminal
if_missing = degrades
native_substitute = none
probe = bin bat

[eza]
layer = env
used_by = config CLAUDE.md, install terminal
if_missing = degrades
native_substitute = none
probe = bin eza

[sd]
layer = env
used_by = config CLAUDE.md
if_missing = degrades
native_substitute = none
probe = bin sd

