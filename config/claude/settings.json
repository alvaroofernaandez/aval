{
  "env": {
    "USER": "alvaroofernaandez",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "medium"
  },
  "permissions": {
    "allow": [
      "mcp__pencil",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf ~)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Edit(.env.*)",
      "Edit(.env)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "skillOverrides": {
    "hallmark": "off",
    "design-shotgun": "off",
    "ai-sdk-5": "off",
    "clerk-setup": "off",
    "clerk-webhooks": "off",
    "clerk-tanstack-patterns": "off",
    "react-doctor": "off",
    "accessibility": "off",
    "owasp-security": "off",
    "tailwind-4": "off",
    "zod-4": "off",
    "clerk-custom-ui": "off",
    "browse": "off",
    "clerk-backend-api": "off",
    "land-and-deploy": "off",
    "repo-prep": "off",
    "high-end-visual-design": "off",
    "anthropic-skills:skill-creator": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then code-review-graph update --skip-flows; fi",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/design-pipeline-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f /tmp/dk_* /tmp/.dk_* /tmp/dk.json 2>/dev/null"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai review stop-hook --agent claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.gstack/bin/gstack-verify-gate\" ] && \"$HOME/.gstack/bin/gstack-verify-gate\" || true",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai review stop-hook --agent claude-code",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai telemetry runtime claude --json",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/design-shot-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai telemetry runtime claude --json",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "bencium-innovative-ux-designer@bencium-marketplace": false,
    "claude-code-wakatime@wakatime": true,
    "claude-security@claude-plugins-official": true,
    "engram@engram": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": false,
    "hasdata@synced": false,
    "flightseatmap@synced": false,
    "variflight@synced": false,
    "alvaro-toolkit@synced": false,
    "quick-peek@better-claude": true,
    "image-preview@better-claude": true,
    "sub-meter@better-claude": true,
    "context-meter@better-claude": true,
    "alvaro-dev-references@synced": false,
    "session-report@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "bencium-marketplace": {
      "source": {
        "source": "github",
        "repo": "bencium/bencium-marketplace"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "wakatime": {
      "source": {
        "source": "git",
        "url": "https://github.com/wakatime/claude-code-wakatime.git"
      }
    },
    "better-claude": {
      "source": {
        "source": "github",
        "repo": "midudev/better-claude"
      }
    }
  },
  "outputStyle": "Neutral",
  "language": "Español",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:soft-dark",
  "skipAutoPermissionPrompt": true,
  "effort": "medium",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "subagentPromptCacheTtl": "1h",
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".pnpm-store",
      ".venv"
    ]
  },
  "spinnerTipsEnabled": false
}
